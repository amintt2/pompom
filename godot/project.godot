; Engine configuration file.
config_version=5

[application]

config/name="Pompom"
config/description="Un petit compagnon tout doux qui vit sur ton bureau."
config/version="0.1.1-beta"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="Pompom"
run/max_fps=30
run/low_processor_mode_sleep_usec=20000
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[autoload]

Data="*res://scripts/autoload/data.gd"
GameState="*res://scripts/autoload/game_state.gd"
Activity="*res://scripts/autoload/activity.gd"

[display]

window/size/viewport_width=260
window/size/viewport_height=300
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/energy_saving/keep_screen_on=false
window/handheld/orientation=1

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/directional_shadow/size=4096
scaling_3d/scale=2.0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
